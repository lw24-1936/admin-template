<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==========================================================================
  admintem-backend :: 基于 Spring Boot 3.5 的权限认证系统（服务端）
  ==========================================================================
  说明：
    1. 本工程为旧项目（demo/RandomSelectionSystem，SpringBoot2.4.2 + JDK8）的
       全新重构版本，仅保留认证与 RBAC 权限相关能力，并升级为：
       Spring Boot 3.5.x + JDK 17、Spring Security 6（无状态 JWT）、
       MyBatis-Plus 3.5（boot3 专用 starter）、Redisson（Redis 客户端，未引入
       spring-boot-starter-data-redis）、springdoc-openapi（Swagger UI 接口文档）。
    2. 数据库与 Redis 与旧项目保持一致：MySQL 库 admintem_new（sys_auth_* 五张表）
       与同一 Redis 实例；本工程对数据库只做增量、可追溯的变更，
       变更脚本统一存放于 docs/db/changelog/ 目录。
    3. 编译要求：JDK 17（将 JAVA_HOME 指向 JDK17 后执行 mvn clean package）。
  ==========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM，统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.admintem</groupId>
    <artifactId>admintem-backend</artifactId>
    <version>1.0.0</version>
    <name>admintem-backend</name>
    <description>权限认证服务端（Spring Boot 3.5 + JDK17 重构版）</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 编译目标：JDK 17（Spring Boot 3.5 最低要求 JDK 17） -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 关键第三方依赖版本（显式声明，便于升级与追溯） -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.9.1</springdoc.version>
        <redisson.version>3.52.0</redisson.version>
    </properties>

    <dependencies>
        <!-- 对象存储（MinIO）；默认不启用，见 admintem.storage.type -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.2.0</version>
        </dependency>
        <!-- Web 支持：MVC + 内嵌 Tomcat + JSON 序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@Valid / @Validated / jakarta.validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security 6：认证 + 方法级权限控制（@PreAuthorize） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Redisson：Redis 客户端（令牌白名单 / 权限缓存 / 登录失败锁定）
             由 RedissonConfig 显式构建 RedissonClient，配置见各环境 yml 的 redisson.* -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- AOP：接口调用日志切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Actuator：仅暴露 health/info 供探活与运维巡检（不暴露 env/beans 等敏感端点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Flyway：数据库版本化迁移（版本由 spring-boot-parent 管理）。
          脚本唯一出处是 admintem-docs/db/changelog，构建时复制到 classpath:db/migration。
          flyway-mysql 为 MySQL 方言支持（Flyway 10+ 拆分为独立模块）。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter），ORM 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 分页插件（3.5.9+ 拆分为独立模块，需显式引入） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动（版本由 Spring Boot BOM 统一管理，兼容 MySQL 8.x/8.4） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT 工具（jjwt 0.12.x 新版 API）：api 编译期、impl/jackson 运行期 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：简化样板代码（编译期处理，不进入产物） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- springdoc-openapi：自动生成 OpenAPI3 文档 + Swagger UI 页面 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 测试支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <!--
              资源过滤：允许在 resources 中使用 Maven 占位符。
              占位符必须写成 @xxx@：spring-boot-starter-parent 已将
              maven-resources-plugin 的分隔符设为 @ 且关闭 ${} 默认分隔符
              （useDefaultDelimiters=false），写成 ${env-flag} 不会被替换，
              会把字面量留在 application.yml 中导致启动失败。
              本工程仅约定 @env-flag@（由下方 profiles 注入），用于
              application.yml 动态切换 spring.profiles.active（dev/test/pre/pro）。
              与旧项目 RandomSelectionSystem 的多环境切换机制保持一致。
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!--
              数据库迁移脚本：**单一出处**在 admintem-docs/db/changelog。
              这里把它作为额外资源目录复制到 classpath:db/migration，供 Flyway 读取，
              避免"文档里一份、代码里一份"的复制漂移。

              必须 filtering=false：SQL 里的 @ 与 ${} 不能被 Maven 过滤改写。
            -->
            <resource>
                <directory>${project.basedir}/../admintem-docs/db/changelog</directory>
                <targetPath>db/migration</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>V*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Spring Boot 打包插件：生成可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 不需要打入可执行包 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ==================================================================
         多环境 Profile（沿用原项目设计）：
         dev（默认）/ test / pre / pro
         每个 Profile 通过 env-flag 属性切换 application-{env}.yml，
         执行示例：
           mvn spring-boot:run                 # dev
           mvn -P test spring-boot:run         # test
           mvn -P pre -DskipTests package      # pre 打包
           mvn -P pro -DskipTests package      # pro 打包
         ================================================================== -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <env-flag>dev</env-flag>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <env-flag>test</env-flag>
            </properties>
        </profile>
        <profile>
            <id>pre</id>
            <properties>
                <env-flag>pre</env-flag>
            </properties>
        </profile>
        <profile>
            <id>pro</id>
            <properties>
                <env-flag>pro</env-flag>
            </properties>
        </profile>
    </profiles>
</project>
