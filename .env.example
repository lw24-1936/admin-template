# ============================================================================
# admintem 本地/演示环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。
# ============================================================================

# MySQL 容器 root 密码（仅首次初始化使用）
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# 应用数据库连接（MySQL 容器会创建该库与用户）
ADMINTEM_DB_HOST=mysql
ADMINTEM_DB_PORT=3306
ADMINTEM_DB_NAME=admintem_new
ADMINTEM_DB_USERNAME=admintem
ADMINTEM_DB_PASSWORD=change-me-db-password

# Redis
ADMINTEM_REDIS_HOST=redis
ADMINTEM_REDIS_PORT=6379
ADMINTEM_REDIS_DATABASE=0
ADMINTEM_REDIS_PASSWORD=change-me-redis-password

# JWT 密钥：至少 32 字节；生产环境必须替换，不能包含 change-me
ADMINTEM_JWT_SECRET=change-me-use-a-long-random-jwt-secret-at-least-32-bytes

# 宿主机端口（可选）
ADMINTEM_BACKEND_PORT=8090
ADMINTEM_DESKTOP_PORT=5175
ADMINTEM_MOBILE_PORT=5174
MYSQL_PORT=3306
REDIS_PORT=6379
